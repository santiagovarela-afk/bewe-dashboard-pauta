# ─────────────────────────────────────────────────────────────────────
# Bewe Pauta · Variables de entorno
# ─────────────────────────────────────────────────────────────────────
# Este archivo es un template. Copialo a `.env.local` y completá los
# valores. NUNCA commitees `.env.local` (ya está en .gitignore).
# En Vercel: Settings → Environment Variables → pega cada uno aquí.
# ─────────────────────────────────────────────────────────────────────

# ─── SECRETOS · server-side · NUNCA exponer al cliente ────────────────

# Meta Business System User Token · permisos full ad account + page
META_TOKEN=

# Google AI Studio · API key Gemini · usado por Mark/Lúa + Open Design + fallback AEO
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048

# Groq · Llama 3.3 70B · 30 RPM gratis · primario para AEO
# Obtener en console.groq.com (sin tarjeta)
GROQ_API_KEY=

# AUTH · array JSON de usuarios autorizados (passwords en claro · server-only)
# Ejemplo (escapar como una sola línea):
# AUTH_USERS_JSON=[{"email":"foo@bewe.io","password":"xxx","role":"admin","name":"Foo"}]
AUTH_USERS_JSON=

# Plan/Strategy rules para el system prompt de Mark/Lúa (opcional)
# Array de strings con reglas operativas del mes vigente.
# Si está vacío, Mark/Lúa funcionan solo con BASE_RULES genéricas.
# AI_MEMORY_RULES_JSON=["Regla 1...","Regla 2..."]
AI_MEMORY_RULES_JSON=

# ─── META IDs · públicos para el cliente · NO son secrets pero los
#     mantenemos fuera del repo público
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_ACCOUNT_ID=
NEXT_PUBLIC_META_ACCOUNT_ID_NUMERIC=
NEXT_PUBLIC_META_PAGE_ID=
NEXT_PUBLIC_META_IG_ID=
NEXT_PUBLIC_META_API_VERSION=v22.0

# ─── PLAN · cifras del período vigente · cliente las muestra en UI ────
NEXT_PUBLIC_PLAN_MONTH_LABEL=Mayo 2026
NEXT_PUBLIC_PLAN_LAUNCH_ISO=2026-05-12T00:00:00
NEXT_PUBLIC_PLAN_END_ISO=2026-05-31T23:59:59
NEXT_PUBLIC_PLAN_DAY7_ISO=2026-05-19T00:00:00
NEXT_PUBLIC_PLAN_DAY14_ISO=2026-05-26T00:00:00
NEXT_PUBLIC_PLAN_TOTAL_DAYS=20
NEXT_PUBLIC_PLAN_BUDGET=0
NEXT_PUBLIC_PLAN_CONTINGENCY=0
NEXT_PUBLIC_PLAN_CPT_AGGRESSIVE=1.57
NEXT_PUBLIC_PLAN_CPT_TARGET=2.20
NEXT_PUBLIC_PLAN_CPT_WARN=3.00
NEXT_PUBLIC_PLAN_CPT_CRITICAL=5.50

# ─── CAMPAIGNS · array JSON con la config de campañas activas ─────────
# Estructura por campaña:
#   { "code": "C1", "cid": "1234...", "name": "...", "event": "CompleteRegistration"|"InitiateCheckout",
#     "geo": "MX|LATAM|...", "vertical": "Belleza|Comercio|Servicios",
#     "daily": 40, "total": 520, "replacedBy"?: "C3.NEW" }
# Ejemplo escapado a una sola línea:
# NEXT_PUBLIC_CAMPAIGNS_JSON=[{"code":"C1","cid":"525...","name":"...","event":"CompleteRegistration","geo":"MX","vertical":"Belleza","daily":40,"total":520}]
NEXT_PUBLIC_CAMPAIGNS_JSON=[]

# ─── UPSTASH REDIS · opcional · rate limiting para los endpoints ──────
# (ver _docs/SECURITY.md sección rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── GOOGLE SEARCH CONSOLE · SEO tab data real ────────────────────────
# Service Account JSON key encoded en base64 (server-only)
# Crear en console.cloud.google.com · IAM & Admin → Service Accounts
# Después agregarlo en Search Console con permiso "Owner" o "Full user"
GOOGLE_SA_KEY=
GSC_SITE_URL=sc-domain:bewe.ai

# ─── GOOGLE ANALYTICS 4 · Captura de trials ────────────────────────
# Property ID numérico (9 dígitos) · GA4 → Admin → Property Settings
GA4_PROPERTY_ID=
# Nombre exacto del evento de trial · default trial_started
GA4_TRIAL_EVENT_NAME=trial_started
# (GOOGLE_SA_KEY ya está agregado para GSC · el mismo SA sirve para GA4
#  · agregar el client_email del SA como "Viewer" en la propiedad GA4)

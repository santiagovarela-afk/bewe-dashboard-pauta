# Meta Graph API · System User Token (long-lived).
# Genera el token en https://business.facebook.com → Configuración del negocio → Usuarios del sistema
# Permisos: ads_read, ads_management, pages_read_engagement, pages_show_list,
# pages_manage_posts, instagram_basic, instagram_content_publish
META_TOKEN=

# Google AI Studio · Gemini Flash · gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Permite saltar el login en local (NUNCA activar en producción)
NEXT_PUBLIC_SKIP_AUTH=false
